# Copy to apps/frontend/.env.local for local development.

# Read by the browser. NEXT_PUBLIC_* is inlined at build time, so changing it
# requires a rebuild, not a restart. In the Compose stack this is `/api`, which
# Nginx serves from the same origin.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Read during server-side rendering, from inside the container network. Falls
# back to NEXT_PUBLIC_API_URL when unset, which is what local development wants.
# INTERNAL_API_URL=http://nginx:80/api
