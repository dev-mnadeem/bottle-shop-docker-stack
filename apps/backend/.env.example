# Copy to apps/backend/.env for local development.

NODE_ENV=development
PORT=4000

# Postgres. The Compose stack injects its own value pointing at the `postgres`
# service; this default assumes a database on the host.
DATABASE_URL=postgres://eco_user:eco_pass@localhost:5432/eco_db

# Signs access tokens. The backend refuses to boot with this value when
# NODE_ENV=production — generate one with: openssl rand -hex 32
JWT_SECRET=dev_only_secret_do_not_use_in_production

# Optional. Leave unset and the app falls back to an in-process cache and rate
# limiter, which is fine for one process and wrong for more than one.
REDIS_URL=redis://localhost:6379

# Required when NODE_ENV=production. Comma-separated CORS allowlist.
# FRONTEND_ORIGIN=https://eco-bottle.example.com

LOG_LEVEL=info

# Lead triage. `rules` is the default deterministic classifier and needs nothing.
# Set `llm` plus a key to route through an OpenAI-compatible endpoint instead;
# any failure there falls back to the rules.
LEAD_TRIAGE_PROVIDER=rules
# LEAD_TRIAGE_API_KEY=sk-...
# LEAD_TRIAGE_API_URL=https://api.openai.com/v1/chat/completions
# LEAD_TRIAGE_MODEL=gpt-4o-mini

# Seed account. Change both before seeding anything that is reachable.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Passw0rd!
