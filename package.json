{
  "name": "eco-bottle",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter backend test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "artillery": "^2.0.34",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "lint-staged": {
    "apps/backend/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "apps/frontend/**/*.{ts,tsx}": [
      "prettier --write",
      "pnpm --filter frontend exec eslint --fix"
    ],
    "*.{json,yml,yaml,mjs,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "source-map-js": "^1.2.2"
    }
  }
}
